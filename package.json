{
  "name": "hoodping-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "VITE_API_URL=https://stage-api.hoodping.example vite --mode staging",
    "build": "vue-tsc --noEmit && vite build --mode development",
    "build:staging": "vue-tsc --noEmit && VITE_API_URL=https://stage-api.hoodping.example vite build --mode staging",
    "build:production": "vue-tsc --noEmit && VITE_API_URL=https://api.hoodping.example vite build --mode production",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-geolocation": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
